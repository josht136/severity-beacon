# OPTIONAL HA-native REST path only (see README "Optional: HA-native REST poll").
# Simple / current path uses severity_beacon_ha.env instead — prefer that.
#
# Copy these keys into Home Assistant: /config/secrets.yaml
# (File editor / Samba / Studio Code Server → secrets.yaml)
#
# PASTE YOUR ZABBIX API TOKEN HERE — replace YOUR_TOKEN_HERE with the real token.
# Create a read-only API token in Zabbix: User → API tokens (or Users → API tokens).

zabbix_api_token: YOUR_TOKEN_HERE

# Full Authorization header value (required by the REST sensor).
# Must be: Bearer <same token as above>
zabbix_api_authorization: Bearer YOUR_TOKEN_HERE
