# Copy to severity_beacon_ha.env and paste your real Zabbix API token.
#   cp severity_beacon_ha.env.example severity_beacon_ha.env
#
# PASTE API KEY HERE — replace YOUR_TOKEN_HERE only in severity_beacon_ha.env
# (that file is gitignored; never commit a real token).

ZABBIX_API_TOKEN=YOUR_TOKEN_HERE

# Optional overrides
ZABBIX_URL=https://zabbix.koti.tech
HA_BASE=http://10.203.3.120
HA_ENTITY=light.koti_office_strip_led
# webhook = uses existing automation.zabbix_led_status (no HA long-lived token)
# api     = needs HA_TOKEN below
HA_MODE=webhook
HA_WEBHOOK_ID=zabbix_led_status
POLL_INTERVAL_SECONDS=45

# Optional: filter like Severity_Beacon -g (Zabbix host group id)
# ZABBIX_HOST_GROUP_ID=

# Optional HA long-lived token only if HA_MODE=api
# HA_TOKEN=YOUR_HA_LONG_LIVED_TOKEN
